# Postgres
POSTGRES_PASSWORD=changeme

# LLM providers (used by the worker container)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Frontend build-time API URL (public backend hostname)
VITE_API_URL=https://ai-workforce-api.manishlab.dev

# Shared password for the app. Empty = no login gate (local dev only).
APP_PASSWORD=

# Backend CORS allow-list
CORS_ORIGINS=http://localhost:5173,https://app.manishlab.dev

# Artifact service (separate repo/deployment, joined to the shared `agent-net`
# docker network so the worker can reach it by container name). Empty =
# artifact_generator tool reports itself as not connected instead of failing.
ARTIFACT_SERVICE_URL=http://artifact-service:8090
ARTIFACT_API_KEY=

# Daily learning digest (Temporal Schedule -> DailyDigestWorkflow). Empty
# RESEND_API_KEY or DIGEST_RECIPIENT_EMAIL means the digest is generated but
# not sent, logged as "not_configured" instead of failing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
DIGEST_RECIPIENT_EMAIL=

# Worker -> backend internal calls (POST /internal/scheduled-tasks, used by
# the schedule_task tool). Must be set for that endpoint to accept anything —
# it's on the public backend URL, so an unset key means "reject everything,"
# not "gate disabled."
INTERNAL_API_KEY=
